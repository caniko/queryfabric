{
  "version": "0.2.0",
  "cases": [
    {
      "id": "simple-scan-filter-project",
      "query": "SELECT record_id FROM records WHERE score > 100 LIMIT 5",
      "required_capabilities": [
        "LimitOffset"
      ],
      "expected_schema": [
        {
          "name": "record_id",
          "data_type": "Uuid",
          "nullable": false
        }
      ],
      "expected_backends": {
        "clickhouse": "supported",
        "postgres": "supported"
      }
    },
    {
      "id": "distinct-order-limit-offset",
      "query": "SELECT DISTINCT record_id FROM records ORDER BY record_id LIMIT 5 OFFSET 2",
      "required_capabilities": [
        "LimitOffset"
      ],
      "expected_schema": [
        {
          "name": "record_id",
          "data_type": "Uuid",
          "nullable": false
        }
      ],
      "expected_backends": {
        "clickhouse": "supported",
        "postgres": "supported"
      }
    },
    {
      "id": "aggregate-group-by-having",
      "query": "SELECT record_id, AVG(score) AS mean_score FROM records GROUP BY record_id HAVING AVG(score) > 100",
      "required_capabilities": [
        "Aggregates"
      ],
      "expected_schema": [
        {
          "name": "record_id",
          "data_type": "Uuid",
          "nullable": false
        },
        {
          "name": "mean_score",
          "data_type": "Float64",
          "nullable": true
        }
      ],
      "expected_backends": {
        "clickhouse": "supported",
        "postgres": "supported"
      }
    },
    {
      "id": "case-expression",
      "query": "SELECT source_record_id, CASE WHEN weight > 1.0 THEN 1 ELSE 0 END AS bucket FROM links LIMIT 1",
      "required_capabilities": [
        "LimitOffset"
      ],
      "expected_schema": [
        {
          "name": "source_record_id",
          "data_type": "Uuid",
          "nullable": false
        },
        {
          "name": "bucket",
          "data_type": "Int64",
          "nullable": false
        }
      ],
      "expected_backends": {
        "clickhouse": "supported",
        "postgres": "supported"
      }
    },
    {
      "id": "common-scalar-functions",
      "query": "SELECT COALESCE(weight, 0.0) AS coalesced, SQRT(weight) AS root, GREATEST(weight, 1.0) AS hi, LEAST(weight, 1.0) AS lo FROM links LIMIT 1",
      "required_capabilities": [
        "LimitOffset"
      ],
      "expected_schema": [
        {
          "name": "coalesced",
          "data_type": "Float64",
          "nullable": false
        },
        {
          "name": "root",
          "data_type": "Float64",
          "nullable": false
        },
        {
          "name": "hi",
          "data_type": "Float64",
          "nullable": false
        },
        {
          "name": "lo",
          "data_type": "Float64",
          "nullable": false
        }
      ],
      "expected_backends": {
        "clickhouse": "supported",
        "postgres": "supported"
      }
    },
